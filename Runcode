<!DOCTYPE html>
<html lang='en'>
<head>
<meta charset='UTF-8'>
<meta name='viewport' content='width=device-width, initial-scale=1.0'>
<title>Contrast Memory Experiment</title>
<style>
body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f2f2f2;
    display:flex;
    justify-content:center;
    align-items:center;
    min-height:100vh;
    text-align:center
}
.container{
    width:90%;
    max-width:900px
}
.card{
    background:white;
    padding:24px;
    border-radius:14px;
    box-shadow:0 4px 14px rgba(0,0,0,0.12)
}
.hidden{
    display:none
}
button{
    padding:14px 24px;
    font-size:18px;
    margin-top:16px;
    cursor:pointer;
    border:none;
    border-radius:10px;
    background-color: #007bff;
    color: white;
}
button:hover{
    background-color: #0056b3;
}
select{
    padding:10px;
    font-size:16px;
    margin-top:10px;
    border-radius:8px
}
img{
    max-width:90vw;
    max-height:70vh;
    border-radius:12px;
    box-shadow:0 3px 10px rgba(0,0,0,0.2);
    transition:filter .2s
}
#recognizeBtn{
    font-size:22px;
    background-color: #28a745;
}
#recognizeBtn:hover {
    background-color: #218838;
}
#feedback{
    height:28px;
    font-size:20px;
    margin-top:10px;
    font-weight: bold;
    color: #28a745;
}
</style>
</head>

<body>
<div class='container'>

<div id='setupScreen' class='card'>
    <h1>Memory Experiment</h1>

    <p><strong>Select Display Mode</strong></p>
    <select id='displayMode'>
        <option value='color'>Colored</option>
        <option value='grayscale'>Greyscale</option>
    </select>

    <br>
    <button id='startBtn'>Start Experiment</button>

    <p id='error' style='color:red;'></p>
</div>

<div id='messageScreen' class='card hidden'>
    <h1 id='messageTitle'></h1>
    <p id='messageText'></p>
    <button id='continueBtn'>Continue</button>
</div>

<div id='experimentScreen' class='hidden'>
    <img id='imageDisplay' src=''>
    <div id='feedback'></div>
    <br>
    <button id='recognizeBtn' class='hidden'>I Recognize This Image</button>
</div>

<div id='resultsScreen' class='card hidden'>
    <h1>Experiment Complete</h1>
    <h2 id='scoreText'></h2>
    <p id='detailsText'></p>
    <button onclick='restartExperiment()'>Restart / Next Participant</button>
</div>

</div>

<script>

// Original 25-image Stage 2 order (10 old, 15 new)
const STAGE2_ORDER = [
    {type:'new', index:0},
    {type:'old', index:2},
    {type:'new', index:1},
    {type:'new', index:2},
    {type:'old', index:5},
    {type:'new', index:3},
    {type:'old', index:7},
    {type:'new', index:4},
    {type:'new', index:5},
    {type:'old', index:9},
    {type:'new', index:6},
    {type:'old', index:11},
    {type:'new', index:7},
    {type:'old', index:13},
    {type:'new', index:8},
    {type:'new', index:9},
    {type:'old', index:15},
    {type:'new', index:10},
    {type:'old', index:16},
    {type:'new', index:11},
    {type:'new', index:12},
    {type:'old', index:18},
    {type:'new', index:13},
    {type:'old', index:19},
    {type:'new', index:14}
];

const setupScreen = document.getElementById('setupScreen');
const messageScreen = document.getElementById('messageScreen');
const experimentScreen = document.getElementById('experimentScreen');
const resultsScreen = document.getElementById('resultsScreen');

const imageDisplay = document.getElementById('imageDisplay');
const recognizeBtn = document.getElementById('recognizeBtn');
const feedback = document.getElementById('feedback');

let studyImages = [];
let newImages = [];
let testImages = [];

let currentIndex = 0;
let correctClicks = 0;
let falseClicks = 0;
let missedRecognitions = 0;

let displayMode = 'color';

function applyImageFilter(){
    if(displayMode === 'grayscale'){
        imageDisplay.style.filter = 'grayscale(100%)';
    } else {
        imageDisplay.style.filter = 'none';
    }
}

function showMessage(title, text, callback){
    setupScreen.classList.add('hidden');
    experimentScreen.classList.add('hidden');
    resultsScreen.classList.add('hidden');
    messageScreen.classList.remove('hidden');

    document.getElementById('messageTitle').innerText = title;
    document.getElementById('messageText').innerText = text;

    document.getElementById('continueBtn').onclick = () => {
        messageScreen.classList.add('hidden');
        callback();
    };
}

document.getElementById('startBtn').onclick = () => {
    displayMode = document.getElementById('displayMode').value;

    // Load exactly 20 study images from folder '20' using your filenames
    studyImages = [];
    for (let i = 4683; i <= 4702; i++) {
        studyImages.push({
            src: '20/IMG_' + i + '.PNG',
            old: true
        });
    }

    // Load exactly 15 new images from folder '15' using your filenames
    newImages = [];
    for (let i = 4705; i <= 4719; i++) {
        newImages.push({
            src: '15/IMG_' + i + '.PNG',
            old: false
        });
    }

    buildFixedTestImages();
    startNewTrial();
};

function buildFixedTestImages(){
    testImages = [];
    for(let item of STAGE2_ORDER){
        if(item.type === 'old'){
            testImages.push(studyImages[item.index]);
        } else {
            testImages.push(newImages[item.index]);
        }
    }
}

function startNewTrial(){
    showMessage(
        'Stage 1',
        'You will now see 20 images. Each image appears for 1 second.',
        startStage1
    );
}

function startStage1(){
    currentIndex = 0;
    experimentScreen.classList.remove('hidden');
    recognizeBtn.classList.add('hidden');
    feedback.innerText = '';
    showStudyImage();
}

function showStudyImage(){
    if(currentIndex >= studyImages.length){
        showMessage(
            'Stage 2',
            'Tap the button whenever you recognize an image from Stage 1.',
            startStage2
        );
        return;
    }

    imageDisplay.src = studyImages[currentIndex].src;
    applyImageFilter();
    currentIndex++;

    setTimeout(showStudyImage, 1000);
}

function startStage2(){
    currentIndex = 0;
    experimentScreen.classList.remove('hidden');
    recognizeBtn.classList.remove('hidden');
    feedback.innerText = '';
    showTestImage();
}

function showTestImage(){
    if(currentIndex >= testImages.length){
        finishExperiment();
        return;
    }

    const currentImage = testImages[currentIndex];
    imageDisplay.src = currentImage.src;
    applyImageFilter();
    feedback.innerText = '';

    let clicked = false;
    let advanced = false;

    function moveNext(){
        if(advanced) return;
        advanced = true;
        currentIndex++;
        showTestImage();
    }

    recognizeBtn.onclick = () => {
        if(clicked) return;
        clicked = true;

        if(currentImage.old){
            correctClicks++;
        } else {
            falseClicks++;
        }

        feedback.innerText = 'Response Recorded';
        setTimeout(moveNext, 300);
    };

    setTimeout(() => {
        if(advanced) return;
        if(currentImage.old && !clicked){
            missedRecognitions++;
        }
        moveNext();
    }, 2000);
}

function finishExperiment(){
    experimentScreen.classList.add('hidden');
    resultsScreen.classList.remove('hidden');

    const modeText = displayMode === 'grayscale' ? 'Greyscale' : 'Colored';
    document.getElementById('scoreText').innerText = 'Display Mode: ' + modeText;

    document.getElementById('detailsText').innerHTML =
        '<strong>Correct Clicks:</strong> ' + correctClicks +
        '<br><strong>False Clicks:</strong> ' + falseClicks +
        '<br><strong>Missed Recognitions:</strong> ' + missedRecognitions;
}

function restartExperiment(){
    correctClicks = 0;
    falseClicks = 0;
    missedRecognitions = 0;
    currentIndex = 0;

    resultsScreen.classList.add('hidden');
    experimentScreen.classList.add('hidden');
    messageScreen.classList.add('hidden');
    setupScreen.classList.remove('hidden');
    document.getElementById('error').innerText = '';
}

</script>
</body>
</html>
